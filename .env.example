# Copy to .env and adjust. Never commit .env (gitignored).

# --- Postgres ---
DB_NAME=nexusops
DB_USER=nexusops
DB_PASSWORD=nexusops

# --- Keycloak ---
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- Reasoning plane LLM ---
# mock (default, offline, deterministic) or anthropic
NEXUS_LLM_PROVIDER=mock
# Required only when NEXUS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Reasoning plane checkpointer ---
# memory (default) or postgres
NEXUS_CHECKPOINTER=memory

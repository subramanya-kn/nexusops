{
  "realm": "nexusops",
  "enabled": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "operator", "description": "Can raise incidents and request diagnosis" },
      { "name": "approver", "description": "Can approve or reject remediation plans" },
      { "name": "admin", "description": "Full control-plane administration" }
    ]
  },
  "clientScopes": [
    {
      "name": "nexus.read",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "nexus.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "nexus.read",
            "claim.value": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "nexusops-cli",
      "enabled": true,
      "publicClient": false,
      "secret": "nexusops-cli-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "reasoning-plane",
      "enabled": true,
      "publicClient": false,
      "secret": "reasoning-plane-secret",
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["nexus.read"],
      "description": "Reasoning-plane service client. Client-credentials only, no realm/client roles ever assigned — read-only by construction, enforced by the absence of ROLE_* authorities, not by convention."
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "approver",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "approver", "temporary": false }],
      "realmRoles": ["operator", "approver"]
    }
  ]
}
